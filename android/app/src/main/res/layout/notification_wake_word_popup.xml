<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wake_word_popup_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wake_word_popup_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/wake_word_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/wake_word_status_chip_bg"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:text="VOICE AKTIF"
        android:textColor="#4F8FF7"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wake_word_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="NARA mendengar kamu"
        android:textColor="#1F2937"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wake_word_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Wake word aktif. Silakan langsung bicara."
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/wake_word_listening_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/wake_word_captured_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="Terdengar: silakan lanjut bicara"
            android:textColor="#374151"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="right"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wake_word_cancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/wake_word_cancel_bg"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Batal"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wake_word_open"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/wake_word_open_bg"
            android:gravity="center"
            android:minWidth="116dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Buka NARA"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
